generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Multi-tenancy (P1 + P2)
// ---------------------------------------------------------------------------
// tenantId is a required, NOT NULL scalar on every tenant-owned model below.
// The P1 migration bridge (@default("tenant_artisans_stories")) was REMOVED in
// P2: writes now go through the tenant-scoped Prisma client (src/lib/tenant-
// prisma.ts), which injects tenantId on every create/where. Because tenantId no
// longer carries a default it is required in Prisma's create-input types, so
// `tsc` proves no unscoped write can omit it. See scripts/P2-NOTES.md.

model Tenant {
  id                     String         @id @default(cuid())
  slug                   String         @unique
  name                   String
  status                 TenantStatus   @default(ACTIVE)
  isPlatformOwner        Boolean        @default(false)
  stripeConnectAccountId String?
  stripeOnboarded        Boolean        @default(false)
  platformFeeBps         Int            @default(300)
  checkoutMode           String         @default("embedded") // "embedded" | "connect_redirect"
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  apiKeys                TenantApiKey[]
  theme                  TenantTheme?
}

model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  keyHash    String    @unique
  prefix     String
  scopes     String[]  @default(["store:read"])
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model TenantTheme {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String   @default("#1f6feb")
  secondaryColor String   @default("#0b3d91")
  accentColor    String   @default("#ff7a18")
  fontHeading    String   @default("Inter")
  fontBody       String   @default("Inter")
  radius         String   @default("md")
  updatedAt      DateTime @updatedAt
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

// ---------------------------------------------------------------------------
// Platform operators (P9) — platform-global identity, NOT tenant-scoped.
// ---------------------------------------------------------------------------
// An operator is an infrastructure super-admin with no tenantId and no AdminUser
// row. These models are deliberately ABSENT from TENANT_SCOPED_MODELS in
// src/lib/tenant-prisma.ts — they have no tenant column and must never be
// auto-scoped. Operators authenticate through the separate `as-platform-session`
// cookie + `/api/auth/platform/*` magic-link flow (see src/lib/platform-session.ts).

model PlatformOperator {
  id          String               @id @default(cuid())
  email       String               @unique
  name        String
  isActive    Boolean              @default(true)
  role        PlatformOperatorRole @default(OPERATOR)
  lastLoginAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model PlatformOperatorToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
}

enum PlatformOperatorRole {
  OPERATOR
}

// PlatformAuditLog (P10) — append-only record of operator actions that cross the
// tenant boundary (notably impersonation start/stop). Platform-global, not
// tenant-scoped; an operator has no tenantId, and `tenantId` here names the
// TARGET tenant of the action, not the operator's own.
model PlatformAuditLog {
  id            String   @id @default(cuid())
  operatorId    String
  operatorEmail String
  action        String // e.g. "impersonate.start", "impersonate.stop"
  tenantId      String?
  detail        String?
  createdAt     DateTime @default(now())

  @@index([operatorId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------

model StoreSettings {
  id                     String   @id @default(cuid())
  tenantId               String
  storeName              String   @default("Artisans Stories")
  storeDescription       String?
  storeLogo              String?
  storeFavicon           String?
  primaryColor           String   @default("#8B6914")
  accentColor            String   @default("#C9A84C")
  fontHeading            String   @default("Cormorant Garamond")
  fontBody               String   @default("Inter")
  contactEmail           String   @default("hello@artisansstories.com")
  contactPhone           String?
  returnPolicyDays       Int      @default(30)
  returnPolicyText       String?
  storeEnabled           Boolean  @default(false)
  instagramUrl           String?
  tiktokUrl              String?
  facebookUrl            String?
  pinterestUrl           String?
  metaTitle              String?
  metaDescription        String?
  googleAnalyticsId      String?
  facebookPixelId        String?
  lowStockThreshold      Int      @default(5)
  lowStockAlertEmail     String?
  orderNotificationEmail String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  adminLogoSize          Int      @default(280)
  productDisclaimer      String?  @default("Each piece is handcrafted by skilled artisans, making every item one-of-a-kind. Natural materials, hand-dyeing, weaving, and hand-finishing mean slight variations in color, texture, size, and pattern from piece to piece — and from the photos shown. These natural differences are not defects; they are the hallmark of authentic handmade craftsmanship and make your piece uniquely yours. We stand behind the quality of every item we sell.")

  @@unique([tenantId])
  @@index([tenantId])
}

model AdminUser {
  id        String    @id @default(cuid())
  tenantId  String
  email     String
  name      String
  role      AdminRole @default(EDITOR)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  phone     String?

  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  @@index([tenantId])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  tenantId  String
  token     String    @unique
  email     String
  type      TokenType @default(CUSTOMER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([tenantId])
}

model Category {
  id          String            @id @default(cuid())
  tenantId    String
  slug        String
  name        String
  description String?
  imageUrl    String?
  parentId    String?
  position    Int               @default(0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]        @relation("CategoryTree")
  products    ProductCategory[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id               String               @id @default(cuid())
  tenantId         String
  slug             String
  name             String
  description      String?
  story            String?
  status           ProductStatus        @default(DRAFT)
  price            Int
  compareAtPrice   Int?
  discountType     ProductDiscountType?
  promoLabel       String?
  promoTheme       ProductPromoTheme?
  costPrice        Int?
  sku              String?
  barcode          String?
  weight           Float?
  weightUnit       String               @default("oz")
  length           Float?
  width            Float?
  height           Float?
  dimensionUnit    String               @default("in")
  tags             String[]
  artisanName      String?
  originCountry    String               @default("El Salvador")
  materialsUsed    String[]
  isFeatured       Boolean              @default(false)
  isDigital        Boolean              @default(false)
  requiresShipping Boolean              @default(true)
  taxCategory      String?
  taxCode          String?
  seoTitle         String?
  seoDescription   String?
  totalSold        Int                  @default(0)
  disclaimer       String?
  showcaseImages   Json                 @default("[]")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  orderItems       OrderItem[]
  artisans         ProductArtisan[]
  categories       ProductCategory[]
  images           ProductImage[]
  options          ProductOption[]
  variants         ProductVariant[]
  reviews          Review[]
  addons           ProductAddon[]

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId])
}

model ProductCategory {
  tenantId   String
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([tenantId])
}

model ProductOption {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  name      String
  values    String[]
  position  Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ProductVariant {
  id              String         @id @default(cuid())
  tenantId        String
  productId       String
  name            String
  optionValues    Json
  sku             String?
  barcode         String?
  price           Int?
  costPrice       Int?
  weight          Float?
  stripeProductId String?
  stripePriceId   String?
  position        Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inventory       Inventory?
  orderItems      OrderItem[]
  images          ProductImage[]
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model ProductImage {
  id        String          @id @default(cuid())
  tenantId  String
  productId String
  variantId String?
  url       String
  urlThumb  String?
  urlMedium String?
  altText   String?
  position  Int             @default(0)
  width     Int?
  height    Int?
  size      Int?
  isDefault Boolean         @default(false)
  createdAt DateTime        @default(now())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([tenantId])
}

model Inventory {
  id                String         @id @default(cuid())
  tenantId          String
  variantId         String         @unique
  quantity          Int            @default(0)
  reservedQuantity  Int            @default(0)
  lowStockThreshold Int            @default(5)
  trackedInventory  Boolean        @default(true)
  allowBackorder    Boolean        @default(false)
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  logs              InventoryLog[]

  @@index([tenantId])
}

model InventoryLog {
  id          String    @id @default(cuid())
  tenantId    String
  inventoryId String
  delta       Int
  reason      String
  note        String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Customer {
  id               String    @id @default(cuid())
  tenantId         String
  email            String
  firstName        String?
  lastName         String?
  phone            String?
  acceptsMarketing Boolean   @default(false)
  stripeCustomerId String?
  totalOrders      Int       @default(0)
  totalSpent       Int       @default(0)
  notes            String?
  tags             String[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastOrderAt      DateTime?
  addresses        Address[]
  orders           Order[]
  reviews          Review[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Address {
  id          String      @id @default(cuid())
  tenantId    String
  customerId  String?
  type        AddressType @default(SHIPPING)
  firstName   String
  lastName    String
  company     String?
  address1    String
  address2    String?
  city        String
  state       String
  stateCode   String
  zip         String
  country     String      @default("United States")
  countryCode String      @default("US")
  phone       String?
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Order {
  id                      String          @id @default(cuid())
  tenantId                String
  orderNumber             String
  customerId              String?
  status                  OrderStatus     @default(PENDING)
  financialStatus         FinancialStatus @default(PENDING)
  email                   String
  phone                   String?
  shippingAddress         Json
  billingAddress          Json?
  subtotal                Int
  discountTotal           Int             @default(0)
  shippingTotal           Int             @default(0)
  taxTotal                Int             @default(0)
  total                   Int
  currency                String          @default("usd")
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  discountCode            String?
  customerNote            String?
  adminNote               String?
  tags                    String[]
  source                  OrderSource     @default(WEB)
  cancelledAt             DateTime?
  cancelReason            String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  stripeTaxTransactionId  String?
  fulfillments            Fulfillment[]
  customer                Customer?       @relation(fields: [customerId], references: [id])
  items                   OrderItem[]
  returns                 Return[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
}

model OrderItem {
  id                String           @id @default(cuid())
  tenantId          String
  orderId           String
  productId         String?
  variantId         String?
  title             String
  variantTitle      String?
  sku               String?
  quantity          Int
  price             Int
  totalDiscount     Int              @default(0)
  total             Int
  productSnapshot   Json
  requiresShipping  Boolean          @default(true)
  fulfillmentStatus String?
  createdAt         DateTime         @default(now())
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product?         @relation(fields: [productId], references: [id])
  variant           ProductVariant?  @relation(fields: [variantId], references: [id])
  returnItems       ReturnItem[]
  addons            OrderItemAddon[]

  @@index([tenantId])
}

model Fulfillment {
  id                String            @id @default(cuid())
  tenantId          String
  orderId           String
  status            FulfillmentStatus @default(PENDING)
  trackingCompany   String?
  trackingNumber    String?
  trackingUrl       String?
  carrier           String?
  service           String?
  shippedAt         DateTime?
  estimatedDelivery DateTime?
  notifyCustomer    Boolean           @default(true)
  items             Json
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Return {
  id             String       @id @default(cuid())
  tenantId       String
  orderId        String
  status         ReturnStatus @default(REQUESTED)
  customerNote   String?
  adminNote      String?
  refundAmount   Int?
  restockItems   Boolean      @default(true)
  stripeRefundId String?
  requestedAt    DateTime     @default(now())
  resolvedAt     DateTime?
  updatedAt      DateTime     @updatedAt
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items          ReturnItem[]

  @@index([tenantId])
}

model ReturnItem {
  id          String       @id @default(cuid())
  tenantId    String
  returnId    String
  orderItemId String
  quantity    Int
  reason      ReturnReason
  note        String?
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  return      Return       @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Discount {
  id                 String       @id @default(cuid())
  tenantId           String
  code               String
  type               DiscountType
  value              Int
  minimumOrderAmount Int?
  appliesToAll       Boolean      @default(true)
  productIds         String[]
  categoryIds        String[]
  usageLimit         Int?
  usageCount         Int          @default(0)
  perCustomerLimit   Int?
  startsAt           DateTime?
  endsAt             DateTime?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
}

model ShippingZone {
  id        String         @id @default(cuid())
  tenantId  String
  name      String
  countries String[]
  regions   String[]
  isActive  Boolean        @default(true)
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  rates     ShippingRate[]

  @@index([tenantId])
}

model ShippingRate {
  id        String        @id @default(cuid())
  tenantId  String
  zoneId    String
  name      String
  condition RateCondition @default(FLAT)
  minValue  Float?
  maxValue  Float?
  price     Int
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  zone      ShippingZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Review {
  id               String       @id @default(cuid())
  tenantId         String
  productId        String
  customerId       String?
  orderId          String?
  rating           Int
  title            String?
  body             String?
  status           ReviewStatus @default(PENDING)
  verifiedPurchase Boolean      @default(false)
  helpfulCount     Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  customer         Customer?    @relation(fields: [customerId], references: [id])
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model WelcomeEmailTemplate {
  id                   String   @id @default(cuid())
  tenantId             String
  logoUrl              String?
  headerBgColor        String?
  cardBgColor          String?
  greetingText         String?
  greetingItalic       Boolean  @default(true)
  bodyParagraph1       String?
  bodyParagraph2       String?
  bulletSectionTitle   String?
  bullet1Label         String?
  bullet1Text          String?
  bullet2Label         String?
  bullet2Text          String?
  bullet3Label         String?
  bullet3Text          String?
  closingText          String?
  signatureText        String?
  signatureName        String?
  signatureSubtitle    String?
  avatarUrl            String?
  instagramUrl         String?
  tiktokUrl            String?
  instagramButtonColor String?
  tiktokButtonColor    String?
  textColorDark        String?
  textColorMedium      String?
  textColorLight       String?
  accentColor          String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  bodyHtml             String?
  socialLinks          Json?
  signatureData        Json?

  @@unique([tenantId])
  @@index([tenantId])
}

model Artisan {
  id                 String           @id @default(cuid())
  tenantId           String
  slug               String
  name               String
  status             ArtisanStatus    @default(DRAFT)
  tagline            String?
  quote              String?
  story              String?
  heroImageUrl       String?
  avatarUrl          String?
  originCountry      String           @default("El Salvador")
  city               String?
  region             String?
  craft              String?
  practicingSince    Int?
  letterToBuyer      String?
  socialLinks        Json?
  metaTitle          String?
  metaDescription    String?
  isFeatured         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  featuredPosts      Json?
  showGallery        Boolean          @default(true)
  socialLinksVisible Json?
  socialEmbedCode    String?
  igAccessToken      String?
  igTokenExpiry      DateTime?
  igUserId           String?
  storyLabel         String?
  images             ArtisanImage[]
  products           ProductArtisan[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model ArtisanImage {
  id        String               @id @default(cuid())
  tenantId  String
  artisanId String
  url       String
  urlThumb  String?
  urlMedium String?
  altText   String?
  caption   String?
  category  ArtisanImageCategory @default(GALLERY)
  position  Int                  @default(0)
  createdAt DateTime             @default(now())
  artisan   Artisan              @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ProductArtisan {
  tenantId  String
  productId String
  artisanId String
  artisan   Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, artisanId])
  @@index([tenantId])
}

model LinkTreeSettings {
  id              String    @id @default(cuid())
  tenantId        String
  title           String    @default("Link Hub")
  description     String?
  logoUrl         String?
  backgroundStyle String?   @default("warm")
  buttonStyle     String?   @default("rounded")
  primaryColor    String?   @default("#8B6914")
  updatedAt       DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  isEnabled       Boolean?  @default(false)
  profileName     String?   @default("Artisans Stories")
  profileBio      String?
  profileImageUrl String?
  backgroundColor String?   @default("#FFFBF0")
  buttonColor     String?   @default("#8B6914")
  textColor       String?   @default("#1F2937")

  @@unique([tenantId])
  @@index([tenantId])
}

model LinkTreeLink {
  id               String             @id @default(cuid())
  tenantId         String
  title            String
  url              String
  description      String?
  icon             String?
  isEnabled        Boolean?           @default(true)
  sortOrder        Int?               @default(0)
  updatedAt        DateTime?          @default(now()) @updatedAt @db.Timestamp(6)
  clicks           Int?               @default(0)
  LinkTreeClickLog LinkTreeClickLog[]

  @@index([tenantId])
}

model LinkTreeClickLog {
  id           String       @id
  tenantId     String
  linkId       String
  clickedAt    DateTime?    @default(now()) @db.Timestamp(6)
  userAgent    String?
  referrer     String?
  ip           String?
  LinkTreeLink LinkTreeLink @relation(fields: [linkId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId])
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

enum TokenType {
  ADMIN
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  PROCESSING
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum FinancialStatus {
  PENDING
  AUTHORIZED
  PAID
  PARTIALLY_PAID
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum OrderSource {
  WEB
  ADMIN
  IMPORT
}

enum FulfillmentStatus {
  PENDING
  OPEN
  SUCCESS
  CANCELLED
  ERROR
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum ProductDiscountType {
  PERCENTAGE
  FIXED
}

enum ProductPromoTheme {
  WARM
  COOL
  BOLD
  SOFT
  DARK
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum RateCondition {
  FLAT
  WEIGHT
  ORDER_VALUE
  FREE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ArtisanStatus {
  DRAFT
  ACTIVE
}

enum ArtisanImageCategory {
  GALLERY
  WORKSHOP
  PROCESS
  PORTRAIT
}

model ContactMessage {
  id        String               @id @default(cuid())
  tenantId  String
  name      String
  email     String
  subject   String               @default("General Inquiry")
  message   String
  status    ContactMessageStatus @default(UNREAD)
  notes     String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  replies   ContactReply[]

  @@index([tenantId])
}

enum ContactMessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model ContactReply {
  id               String         @id @default(cuid())
  tenantId         String
  contactMessageId String
  body             String
  direction        ReplyDirection @default(OUTBOUND)
  senderName       String         @default("Artisans' Stories")
  createdAt        DateTime       @default(now())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

enum ReplyDirection {
  OUTBOUND
  INBOUND
}

model EmailLog {
  id          String         @id @default(cuid())
  tenantId    String
  type        EmailLogType
  direction   EmailDirection @default(OUTBOUND)
  toEmail     String
  fromEmail   String         @default("hello@artisansstories.com")
  subject     String
  bodyHtml    String?        @db.Text
  resendId    String?
  relatedId   String?
  relatedType String?
  createdAt   DateTime       @default(now())

  @@index([tenantId])
}

enum EmailLogType {
  ORDER_CONFIRMATION
  ORDER_CANCELLED
  ORDER_REFUNDED
  ORDER_SHIPPED
  MAGIC_LINK_CUSTOMER
  MAGIC_LINK_ADMIN
  CONTACT_INBOUND
  CONTACT_REPLY
  RETURN_REQUEST
  RETURN_APPROVED
  RETURN_REJECTED
  REFUND_ISSUED
  SUBSCRIBE_WELCOME
  SYSTEM
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

model KBArticle {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  slug        String
  category    String
  excerpt     String
  content     String   @db.Text
  readTimeMin Int      @default(3)
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

enum AddonType {
  LASER_MONOGRAM
}

model ProductAddon {
  id        String    @id @default(cuid())
  tenantId  String
  productId String
  type      AddonType
  isEnabled Boolean   @default(true)
  config    Json
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, type])
  @@index([tenantId])
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  tenantId    String
  orderItemId String
  type        AddonType
  data        Json
  price       Int       @default(0)
  createdAt   DateTime  @default(now())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
