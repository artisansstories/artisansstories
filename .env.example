# MailerLite
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Cloudflare R2 (image/asset uploads)
# S3-compatible object storage for product, branding, landing-page, and email
# assets. All five are required for live uploads; if the access key + secret are
# unset, the admin uploader falls back to mock URLs (dev only).
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-bucket-name
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev

# Optional: enables AI-generated alt text on product image uploads (Gemini via
# OpenRouter). Uploads work without it; alt text is simply skipped.
OPENROUTER_API_KEY=

# Tenant subdomain auto-provisioning (TD1)
# When a tenant is created, its subdomain ({slug}.artisansstories.com) is
# registered individually in Cloudflare DNS (CNAME → cname.vercel-dns.com,
# DNS-only) and attached to the Vercel project (so Vercel issues a per-domain
# cert). A wildcard cert isn't possible while DNS lives on Cloudflare.
# If any are unset, provisioning is skipped (non-fatal) and tenants still create.
CLOUDFLARE_ZONE_ID=your-cloudflare-zone-id
CLOUDFLARE_DNS_TOKEN=your-cloudflare-dns-token
VERCEL_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=your-vercel-project-id
VERCEL_TEAM_ID=your-vercel-team-id

# Platform operators (P9)
# Comma-separated emails seeded as platform operators by
# scripts/seed-platform-operator.ts. If unset, the script seeds the two default
# bootstrap operators (wayne@orangeslicesport.com, mike@orangeslicesport.com).
PLATFORM_OPERATOR_EMAILS=

# MCP server (AI assistants: Muse, Grokbot, Claude, ChatGPT). See docs/MCP.md.
# MCP_ENABLED must be "true" AND MCP_TOKEN_SECRET set (>= 32 chars) or every
# /api/mcp, /oauth/* and /.well-known/oauth-* endpoint returns 404. Per-store
# access is also off until a store admin enables it in Settings → AI Assistants.
MCP_ENABLED=false
# openssl rand -base64 48 — rotating it revokes all OAuth tokens (not API keys)
MCP_TOKEN_SECRET=
# Optional. Comma-separated EXACT hostnames allowed as OAuth redirect_uri hosts.
# Default: claude.ai,www.claude.ai,claude.com,www.claude.com,chatgpt.com,platform.openai.com
MCP_OAUTH_REDIRECT_HOSTS=
